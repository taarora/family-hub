.DS_Store

# Personal config values — never publish these to the public repo
SETTINGS-CHEATSHEET.md

# Python cache from public_client.py testing
__pycache__/
*.pyc

# Local backup snapshots from the app's "Backup Data" button — these contain
# real family data (chores/groceries/recipes) and this repo is public.
family-hub-backup-*.json

# Exported Hub settings land here (see Settings -> Export Config) if a
# browser's downloads location is pointed at this folder. Contains the same
# sensitive values as SETTINGS-CHEATSHEET.md, so it's git-ignored the same way.
config/*.json

# Home dashboard runtime config (Firebase RTDB URL, home location, LAN URLs) —
# sensitive, same reasoning as SETTINGS-CHEATSHEET.md above.
family-hub-config.json

# Local data backups (chores/groceries/recipes + a stray index.html snapshot) —
# real family data, this repo is public.
backups/
